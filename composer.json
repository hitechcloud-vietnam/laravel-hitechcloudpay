{
    "name": "hitechcloud-vietnam/laravel-hitechcloudpay",
    "description": "SDK Laravel chính thức cho hệ sinh thái HiTechCloud: Pay (cổng thanh toán, Pay API v2, BankHub, SoundBox, hoá đơn điện tử), eKYC/VNeID, POS, Omnichannel, CRM, WAF, Sale AI, API Tools và User API - kèm migration, route webhook, event và job hàng đợi.",
    "keywords": [
        "laravel",
        "hitechcloud",
        "sdk",
        "payment",
        "payment-gateway",
        "vietqr",
        "napas",
        "ekyc",
        "vneid",
        "pos",
        "omnichannel",
        "crm",
        "waf",
        "sale-ai",
        "open-banking",
        "e-invoice",
        "webhook",
        "vietnam"
    ],
    "homepage": "https://developers.hitechcloud.vn",
    "license": "MIT",
    "authors": [
        {
            "name": "HiTechCloud",
            "email": "dev@hitechcloud.vn",
            "homepage": "https://hitechcloud.vn",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/hitechcloud-vietnam/laravel-hitechcloudpay/issues",
        "source": "https://github.com/hitechcloud-vietnam/laravel-hitechcloudpay",
        "docs": "https://developers.hitechcloud.vn"
    },
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10|^11",
        "orchestra/testbench": "^7|^8|^9|^10"
    },
    "autoload": {
        "psr-4": {
            "HiTechCloud\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HiTechCloud\\Pay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HiTechCloud\\Pay\\HiTechCloudPayServiceProvider"
            ],
            "aliases": {
                "HiTechCloud": "HiTechCloud\\Facades\\HiTechCloud",
                "HiTechCloudPay": "HiTechCloud\\Pay\\Facades\\HiTechCloudPay"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
